  "kernel": {
   "block_param": "BLOCK_SIZE",
   "lean_match": true,
   "n_param": "n_elements",
   "name": "add_kernel",
   "out": "out_ptr",
   "ptr_params": [
    "in_ptr0",
    "in_ptr1"
   ],
   "statements": [
    "pid=tl.program_id(axis=0)",
    "block_start=pid*BLOCK_SIZE",
    "offsets=block_start+tl.arange(0,BLOCK_SIZE)",
    "mask=offsets<n_elements",
    "x=tl.load(in_ptr0+offsets,mask=mask)",
    "y=tl.load(in_ptr1+offsets,mask=mask)",
    "output=x+y",
    "tl.store(out_ptr+offsets,output,mask=mask)"
   ]
  },
  "launch": {
   "binding": {
    "BLOCK_SIZE": "BLOCK_SIZE",
    "in_ptr0": "x",
    "in_ptr1": "y",
    "n_elements": "n_elements",
    "out_ptr": "out"
   },
   "block": 4,
   "grid_kind": "cdiv",
   "out_alloc": [
    "out",
    "x"
   ]
  },
  "manifest": "bench/tritonbench_g/add_example/improvement/launch_manifest.json",
